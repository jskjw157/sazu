# Local research only. Never paste these server-side keys into a browser application.
# Generate EACH value independently, e.g. python -c "import secrets; print(secrets.token_hex(32))"
RESEARCH_API_TOKEN=
CALCULATOR_TOKEN=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
# The variables below apply to direct local startup; Compose supplies its private service names.
SAZU_MODE=research
HOST=127.0.0.1
PORT=3000
PYTHON_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://sazu_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/sazu
